# DeepSeek (recommended) — https://platform.deepseek.com/api_keys
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

# Optional aliases (same values)
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro

# Do NOT use Volcengine Coding Plan URL for this website (IDE-only, separate subscription):
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# Local dev only — do not set on Vercel/production
OPENAI_ALLOW_INSECURE_TLS=true
